{
  "name": "skydrop-desktop",
  "version": "1.0.44",
  "description": "SkyDrop - Fast, private local file drop for Linux and mobile",
  "homepage": "https://github.com/PMGEECODE/skydrop",
  "author": {
    "name": "SkyDrop Team",
    "email": "dev@skydrop.local"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "node tests/desktop.test.js",
    "bump": "node scripts/bump-version.js",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "build:daemon": "node scripts/build-daemon.js",
    "build:daemon:win": "node scripts/build-daemon.js --win",
    "build:daemon:all": "node scripts/build-daemon.js --all",
    "prebuild": "node scripts/bump-version.js",
    "build": "npm run dist",
    "postbuild": "node scripts/copy-release.js",
    "prebuild:all": "node scripts/bump-version.js",
    "build:all": "npm run dist:all",
    "postbuild:all": "node scripts/copy-release.js",
    "predist": "node scripts/bump-version.js",
    "dist": "npm run build:daemon && electron-builder --linux",
    "postdist": "node scripts/copy-release.js",
    "predist:appimage": "node scripts/bump-version.js",
    "dist:appimage": "npm run build:daemon && electron-builder --linux AppImage",
    "postdist:appimage": "node scripts/copy-release.js",
    "predist:deb": "node scripts/bump-version.js",
    "dist:deb": "npm run build:daemon && electron-builder --linux deb",
    "postdist:deb": "node scripts/copy-release.js",
    "predist:win": "node scripts/bump-version.js",
    "dist:win": "npm run build:daemon:win && electron-builder --win nsis:x64",
    "postdist:win": "node scripts/copy-release.js",
    "predist:all": "node scripts/bump-version.js",
    "dist:all": "npm run build:daemon:all && electron-builder --linux --win",
    "postdist:all": "node scripts/copy-release.js"
  },
  "keywords": [
    "file-transfer",
    "airdrop",
    "skydrop",
    "local-network",
    "electron"
  ],
  "license": "MIT",
  "build": {
    "appId": "com.famage.skydrop",
    "productName": "SkyDrop",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "PMGEECODE",
      "repo": "skydrop-release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "SkyDrop Team <dev@skydrop.local>",
      "category": "Network",
      "synopsis": "Seamless local network file dropping",
      "icon": "assets/icon.png",
      "artifactName": "skydrop-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "afterInstall": "build/debian/after-install.sh"
    },
    "appImage": {
      "artifactName": "skydrop-${version}-linux-x86_64.AppImage"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "skydrop-${version}-win-x64-setup.exe",
      "extraResources": [
        {
          "from": "bin/skydrop-daemon.exe",
          "to": "bin/skydrop-daemon.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyDrop",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "${productName}"
    },
    "extraResources": [
      {
        "from": "bin/skydrop-daemon",
        "to": "bin/skydrop-daemon"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
